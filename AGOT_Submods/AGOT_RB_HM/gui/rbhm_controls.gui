types rbhm_types {
	type rbhm_controls = widget {
		name = "rbhm_controls"
		size = { 116 184 }
		alwaystransparent = no
		visible = "[GetScriptedGui('rbhm_legacy_add_slot').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('gui_holding', HoldingView.GetProvince.MakeScope).End)]"
		state = {
			name = rbhm_initialize
			trigger_when = "[GetScriptedGui('rbhm_initialize').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('province', HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('character', GetPlayer.MakeScope).AddScope('holder', HoldingView.GetHolder.MakeScope).AddScope('founder', HoldingView.GetHolder.MakeScope).AddScope('owner', HoldingView.GetHolder.MakeScope).AddScope('county', HoldingView.GetCountyTitle.MakeScope).AddScope('duchy_slot', MakeScopeBool(HoldingView.HasDuchyCapitalBuildingSlot)).AddScope('special_slot', MakeScopeFlag(Select_CString(HoldingView.HasSpecialBuildingSlot, HoldingView.GetGUISpecialBuilding.GetCurrentOrConstrucingBuilding.GetKey, 'none'))).End)]"
			on_start = "[GetScriptedGui('rbhm_initialize').Execute(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('province', HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('character', GetPlayer.MakeScope).AddScope('holder', HoldingView.GetHolder.MakeScope).AddScope('founder', HoldingView.GetHolder.MakeScope).AddScope('owner', HoldingView.GetHolder.MakeScope).AddScope('county', HoldingView.GetCountyTitle.MakeScope).AddScope('duchy_slot', MakeScopeBool(HoldingView.HasDuchyCapitalBuildingSlot)).AddScope('special_slot', MakeScopeFlag(Select_CString(HoldingView.HasSpecialBuildingSlot, HoldingView.GetGUISpecialBuilding.GetCurrentOrConstrucingBuilding.GetKey, 'none'))).End)]"
		}
		button_icon = {
			name = "rbhm_main_upgrade_button"
			size = { 52 52 }
			position = { 4 0 }
			enabled = "[GetScriptedGui('rbhm_main_upgrade').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('province', HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('character', GetPlayer.MakeScope).AddScope('holder', HoldingView.GetHolder.MakeScope).AddScope('founder', HoldingView.GetHolder.MakeScope).AddScope('owner', HoldingView.GetHolder.MakeScope).AddScope('county', HoldingView.GetCountyTitle.MakeScope).AddScope('duchy_slot', MakeScopeBool(HoldingView.HasDuchyCapitalBuildingSlot)).AddScope('special_slot', MakeScopeFlag(Select_CString(HoldingView.HasSpecialBuildingSlot, HoldingView.GetGUISpecialBuilding.GetCurrentOrConstrucingBuilding.GetKey, 'none'))).End)]"
			onclick = "[GetScriptedGui('rbhm_main_upgrade').Execute(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('province', HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('character', GetPlayer.MakeScope).AddScope('holder', HoldingView.GetHolder.MakeScope).AddScope('founder', HoldingView.GetHolder.MakeScope).AddScope('owner', HoldingView.GetHolder.MakeScope).AddScope('county', HoldingView.GetCountyTitle.MakeScope).AddScope('duchy_slot', MakeScopeBool(HoldingView.HasDuchyCapitalBuildingSlot)).AddScope('special_slot', MakeScopeFlag(Select_CString(HoldingView.HasSpecialBuildingSlot, HoldingView.GetGUISpecialBuilding.GetCurrentOrConstrucingBuilding.GetKey, 'none'))).End)]"
			texture = "gfx/interface/icons/rbhm/main_upgrade_inactive.dds"
			framesize = { 128 128 }
			blockoverride "button_icon_modify_texture" {}
			blockoverride "button_frames" {
				gfxtype = togglepushbuttongfx
				effectname = "NoHighlight"
				upframe = 1
				uphoverframe = 1
				uppressedframe = 1
				downframe = 1
				downhoverframe = 1
				downpressedframe = 1
				disableframe = 1
			}
			icon = {
				name = "rbhm_main_upgrade_active_artwork"
				size = { 100% 100% }
				alwaystransparent = yes
				visible = "[GetScriptedGui('rbhm_main_upgrade').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('province', HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('character', GetPlayer.MakeScope).AddScope('holder', HoldingView.GetHolder.MakeScope).AddScope('founder', HoldingView.GetHolder.MakeScope).AddScope('owner', HoldingView.GetHolder.MakeScope).AddScope('county', HoldingView.GetCountyTitle.MakeScope).AddScope('duchy_slot', MakeScopeBool(HoldingView.HasDuchyCapitalBuildingSlot)).AddScope('special_slot', MakeScopeFlag(Select_CString(HoldingView.HasSpecialBuildingSlot, HoldingView.GetGUISpecialBuilding.GetCurrentOrConstrucingBuilding.GetKey, 'none'))).End)]"
				texture = "gfx/interface/icons/rbhm/main_upgrade_active.dds"
			}
			tooltip = "[GetScriptedGui('rbhm_main_upgrade').BuildTooltip(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('province', HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('character', GetPlayer.MakeScope).AddScope('holder', HoldingView.GetHolder.MakeScope).AddScope('founder', HoldingView.GetHolder.MakeScope).AddScope('owner', HoldingView.GetHolder.MakeScope).AddScope('county', HoldingView.GetCountyTitle.MakeScope).AddScope('duchy_slot', MakeScopeBool(HoldingView.HasDuchyCapitalBuildingSlot)).AddScope('special_slot', MakeScopeFlag(Select_CString(HoldingView.HasSpecialBuildingSlot, HoldingView.GetGUISpecialBuilding.GetCurrentOrConstrucingBuilding.GetKey, 'none'))).End)]"
			using = tooltip_ne
			tooltipwidget = {
				container = {
					using = GeneralTooltipSetup
					alwaystransparent = no
					widget = {
						name = "background"
						using = DefaultTooltipBackground
						size = { 100% 100% }
						alwaystransparent = no
					}
					flowcontainer = {
						direction = vertical
						margin = { 20 12 }
						scrollbox = {
							size = { 480 400 }
							blockoverride "scrollbox_content" {
								textbox = {
									using = DefaultTooltipText
									using = Font_Type_Standard
									using = Font_Size_Small
									max_width = 440
									fonttintcolor = "[TooltipInfo.GetTintColor]"
									text = "[GetScriptedGui('rbhm_main_upgrade').BuildTooltip(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('province', HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('character', GetPlayer.MakeScope).AddScope('holder', HoldingView.GetHolder.MakeScope).AddScope('founder', HoldingView.GetHolder.MakeScope).AddScope('owner', HoldingView.GetHolder.MakeScope).AddScope('county', HoldingView.GetCountyTitle.MakeScope).AddScope('duchy_slot', MakeScopeBool(HoldingView.HasDuchyCapitalBuildingSlot)).AddScope('special_slot', MakeScopeFlag(Select_CString(HoldingView.HasSpecialBuildingSlot, HoldingView.GetGUISpecialBuilding.GetCurrentOrConstrucingBuilding.GetKey, 'none'))).End)]"
								}
							}
						}
					}
				}
			}
		}
