window = {
 name = "agot_di_rusbar_eye_window"
 parentanchor = center
 layer = windows_layer
 size = { 1100 820 }
 filter_mouse = all
 allow_outside = yes
 using = Window_Background
 using = Window_Decoration
 movable = yes
 visible = "[GetPlayer.MakeScope.Var('agot_di_rusbar_eye_open').IsSet]"
 datacontext = "[GetPlayer.MakeScope.Var('agot_di_rusbar_eye_target').Char]"
 state = { name = _show using = Animation_FadeIn_Quick
  on_finish = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'base')]"
  on_finish = "[GetVariableSystem.Set('agot_di_rusbar_eye_panel', 'offices')]"
  on_finish = "[PdxGuiWidget.StackTop]"
 }
 vbox = {
  using = Window_Margins
  spacing = 8
  header_pattern = {
   layoutpolicy_horizontal = expanding
   blockoverride "header_text" { text = "agot_di_rusbar_eye_interaction" }
   blockoverride "button_close" { onclick = "[GetScriptedGui('agot_di_rusbar_eye_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
  }
  text_single = { layoutpolicy_horizontal = expanding text = "[Character.GetUINameNoTooltip]" default_format = "#bold" }
  text_multi = { layoutpolicy_horizontal = expanding text = "agot_di_rusbar_eye_lore" }
  text_multi = { layoutpolicy_horizontal = expanding text = "agot_di_rusbar_eye_settings_hint" default_format = "#low" }
  hbox = {
   spacing = 8
   button_standard = {
	layoutpolicy_horizontal = expanding
	raw_text = "−"
	onclick = "[GetScriptedGui('agot_di_rusbar_eye_age_less').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	enabled = "[GetScriptedGui('agot_di_rusbar_eye_age_less').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
}

   text_single = { text = "agot_di_rusbar_eye_age" }
   text_single = { text = "[GetPlayer.MakeScope.Var('agot_di_rusbar_eye_age').GetValue|0]" }
   button_standard = {
	layoutpolicy_horizontal = expanding
	raw_text = "+"
	onclick = "[GetScriptedGui('agot_di_rusbar_eye_age_more').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	enabled = "[GetScriptedGui('agot_di_rusbar_eye_age_more').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
}

   button_standard = {
	layoutpolicy_horizontal = expanding
	text = "agot_di_rusbar_eye_gender_random"
	onclick = "[GetScriptedGui('agot_di_rusbar_eye_gender_random').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	enabled = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('agot_di_rusbar_eye_gender').GetValue, '(CFixedPoint)50'))]"
}

   button_standard = {
	layoutpolicy_horizontal = expanding
	text = "agot_di_rusbar_eye_gender_male"
	onclick = "[GetScriptedGui('agot_di_rusbar_eye_gender_male').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	enabled = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('agot_di_rusbar_eye_gender').GetValue, '(CFixedPoint)0'))]"
}

   button_standard = {
	layoutpolicy_horizontal = expanding
	text = "agot_di_rusbar_eye_gender_female"
	onclick = "[GetScriptedGui('agot_di_rusbar_eye_gender_female').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	enabled = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('agot_di_rusbar_eye_gender').GetValue, '(CFixedPoint)100'))]"
}

  }
  hbox = {
   spacing = 8
   button_standard = { layoutpolicy_horizontal = expanding
    text = "[GetPlayer.MakeScope.Var('agot_di_rusbar_eye_culture').Culture.GetNameNoTooltip]"
    tooltip = "agot_di_rusbar_eye_culture"
    onclick = "[GetVariableSystem.Set(ConcatIfNeitherEmpty('agot_di_rusbar_eye_heritage_', GetPlayer.MakeScope.Var('agot_di_rusbar_eye_culture').Culture.GetHeritage.GetNameNoTooltip), 'yes')]"
    onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_panel', 'culture')]"
   }
   button_standard = { layoutpolicy_horizontal = expanding
    text = "[GetPlayer.MakeScope.Var('agot_di_rusbar_eye_faith').Faith.GetNameNoTooltip]"
    tooltip = "agot_di_rusbar_eye_faith"
    onclick = "[GetVariableSystem.Set(ConcatIfNeitherEmpty('agot_di_rusbar_eye_religion_', GetPlayer.MakeScope.Var('agot_di_rusbar_eye_faith').Faith.GetReligion.GetNameNoTooltip), 'yes')]"
    onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_panel', 'faith')]"
   }
   button_standard = {
	layoutpolicy_horizontal = expanding
	text = "agot_di_rusbar_eye_reset_origin"
	onclick = "[GetScriptedGui('agot_di_rusbar_eye_reset_origin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
}

  }
  vbox = {
   layoutpolicy_horizontal = expanding
   layoutpolicy_vertical = expanding
   visible = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_panel', 'offices')]"
   hbox = { layoutpolicy_horizontal = expanding
button_tab = { layoutpolicy_horizontal = expanding
 onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'base')]"
 down = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'base')]"
 text_single = { parentanchor = center text = "agot_di_rusbar_tab_base" default_format = "#small" }
}
button_tab = { layoutpolicy_horizontal = expanding
 onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'general')]"
 down = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'general')]"
 text_single = { parentanchor = center text = "agot_di_rusbar_tab_general" default_format = "#small" }
}
button_tab = { layoutpolicy_horizontal = expanding
 onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'cultural')]"
 down = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'cultural')]"
 text_single = { parentanchor = center text = "agot_di_rusbar_tab_cultural" default_format = "#small" }
}
button_tab = { layoutpolicy_horizontal = expanding
 onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'titular')]"
 down = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'titular')]"
 text_single = { parentanchor = center text = "agot_di_rusbar_tab_titular" default_format = "#small" }
}
   }
   hbox = { layoutpolicy_horizontal = expanding
button_tab = { layoutpolicy_horizontal = expanding
 onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'crownlands')]"
 down = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'crownlands')]"
 text_single = { parentanchor = center text = "agot_di_rusbar_tab_crownlands" default_format = "#small" }
}
button_tab = { layoutpolicy_horizontal = expanding
 onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'watch')]"
 down = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'watch')]"
 text_single = { parentanchor = center text = "agot_di_rusbar_tab_watch" default_format = "#small" }
}
button_tab = { layoutpolicy_horizontal = expanding
 onclick = "[GetVariableSystem.Set('agot_di_rusbar_eye_tab', 'camp')]"
 down = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'camp')]"
 text_single = { parentanchor = center text = "agot_di_rusbar_tab_camp" default_format = "#small" }
}
   }
scrollbox = {
 layoutpolicy_horizontal = expanding
 layoutpolicy_vertical = expanding
 visible = "[GetVariableSystem.HasValue('agot_di_rusbar_eye_tab', 'base')]"
 blockoverride "scrollbox_content" { vbox = { layoutpolicy_horizontal = expanding spacing = 4
 text_multi = { layoutpolicy_horizontal = expanding text = "agot_di_rusbar_eye_empty" visible = "[Not(GetScriptedGui('agot_di_rusbar_eye_tab_base_available').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
