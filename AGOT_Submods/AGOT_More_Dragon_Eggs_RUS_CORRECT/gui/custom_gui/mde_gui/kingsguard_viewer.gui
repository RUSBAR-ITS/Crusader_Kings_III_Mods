window = {
	name = "kingsguard_viewer_window"
	visible = "[And( And( Not( IsGameViewOpen('barbershop') ), IsDefaultGUIMode ), GetVariableSystem.Exists( 'kingsguard_viewer_toggle' ) )]"
	parentanchor = center
	widgetanchor = center
	size = { 1320 785 }
	layer = middle
	alpha = 1

	using = Window_Background
    using = Window_Decoration_Spike

	state = {
        name = _show
        using = Animation_FadeIn_Standard
        using = Sound_WindowShow_Standard
		on_start = "[PdxGuiWidget.StackTop]"
    }


    state = {
        name = _hide
        using = Animation_FadeOut_Quick
        using = Sound_WindowHide_Standard
    }

	margin_widget = {
		name = "foreground_shader_vfx_container"
		position = { 40 20 }
		size = { 100% 100% }
		margin = { 40 20 }
	}
	margin_widget = {
		name = "faux_event_background"
		size = { 100% 100% }
		margin = { 40 20 }

		state = {
			name = _show
			using = Animation_FadeIn_Standard
			duration = 0.7
		}

		state = {
			name = background_shake_loop
			next = background_shake_loop_1
			duration = 0.0
			alpha = 1.0
		}

		state = {
			name = background_shake_loop_1
			next = background_shake_loop_2
			position = { -6 0 }
			duration = 0.2
		}

		state = {
			name = background_shake_loop_2
			next = background_shake_loop_3
			position = { 5 0 }
			duration = 0.12
		}

		state = {
			name = background_shake_loop_3
			next = background_shake_loop_1
			position = { 7 1 }
			duration = 0.12
		}

		blockoverride "event_picture_properties"
		{}
		widget = {
			name = "event_picture"
			size = { 100% 100% }

			background = {
				texture = "gfx/interface/illustrations/event_scenes/ironthrone/throneroom_ironthrone.dds"
				fittype = centercrop

				block "event_mask" {
					modify_texture = {
						name = mask
						texture = "gfx/interface/window_event/mask_event_image_large.dds"
						blend_mode = alphamultiply

						block "event_mask_properties"
						{
							loop = no
						}
					}
				}

				block "event_picture_properties"
				{
				}
			}
		}
	}
	
	
	vbox = {
		name = "not_event_window"
		using = Animation_Tab_Switch
		layoutpolicy_vertical = expanding
		spacer = { size = { 0 12 } }
		widget = {
			name = "kingsguard_viewer_window_widget"
			size = { 1220 690 }
			vbox = {				
				vbox = {
					allow_outside = yes
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
		
					vbox = {
						ignoreinvisible = yes
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							#max_width = 320
				

							blockoverride "scrollbox_content"
							{
					
								button_standard = {
									name = "background_button"
									size = { 402 68 } # Size of the button frame borders; needs to fit within the widget size
									using = tooltip_ws
									#layoutpolicy_vertical = expanding
									datacontext = "[GetTitleByKey('d_kingsguard').GetHolder]"
									visible = "[GetTitleByKey('d_kingsguard').GetHolder.IsValid]"

									tooltipwidget = {
										cooltip_type = {
											blockoverride "interaction_info" {
												text = "CHARACTER_TOOLTIP_INSTRUCTION"
											}
										}
									}
									tooltip_offset = { 0 0 }
									tooltip_verticalbehavior = slide
									tooltip_horizontalbehavior = mirror
									portrait_head_small = {
										scale = 0.75
										parentanchor = right
										datacontext = "[GetTitleByKey('d_kingsguard').GetHolder.MakeScope.Var('current_dragon').GetCharacter]"
										tooltipwidget = {
											cooltip_type = {
												blockoverride "interaction_info"
												{
													text = "CHARACTER_TOOLTIP_INSTRUCTION"
												}
											}
										}
										visible = "[GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(GetTitleByKey('d_kingsguard').GetHolder.MakeScope).End)]"
									}
									mde_view_kingsguard_portrait_head_small = {
										scale = 0.75
										tooltip_visible = no
									}
									vbox = {
										expand = {}
										ignoreinvisible = yes
										spacing = -3
										margin_left = 70
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										hbox = {
											layoutpolicy_horizontal = expanding
											text_single = {
												visible = "[GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
												name = "character_name_with_dragon"
												text = "[Character.GetUINameNotMeNoTooltip]"
												fontsize = 18
												fontsize_min = 10
												max_width = 215
											}
											text_single = {
												visible = "[Not(GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
												name = "character_name"
												text = "[Character.GetUINameNotMeNoTooltip]"
												fontsize = 18
												max_width = 275
											}
											expand = {}
										}
										hbox = {
											visible = yes
											layoutpolicy_horizontal = expanding
											text_multi = {
												layoutpolicy_horizontal = expanding
												name = "lord_commander"
												text = "mde_is_lord_commander"
												fontsize = 13
												autoresize = yes
												max_width = 225
											}
											expand = {}
										}
										hbox = {
											margin_left = -2
											layoutpolicy_horizontal = expanding
								
											dynamicgridbox = {
												visible = "[Not(GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
												flipdirection = yes
												ignoreinvisible = yes
												name = "traits_tiny"
												datamodel = "[GetGlobalList('kingsguard_relevant_traits')]"
									
									
												item = {
													icon_trait = {
														datacontext = "[Scope.Trait]"
														visible = "[GetScriptedGui('mde_is_kingsguard_relevant_trait').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope( 'relevant_trait', Trait.MakeScope ).End)]"		
														blockoverride "icon_size" {
															size = { 20 20 }
														}
														blockoverride "glow_radius" {
															glow_radius = 3
														}
													}
												}
											}
											dynamicgridbox = {
												visible = "[GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
												flipdirection = yes
												ignoreinvisible = yes
												name = "traits_tiny_with_dragon"
												datamodel = "[GetGlobalList('kingsguard_relevant_traits')]"
									
									
												item = {
													icon_trait = {
														datacontext = "[Scope.Trait]"
														visible = "[GetScriptedGui('mde_is_kingsguard_relevant_trait').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope( 'relevant_trait', Trait.MakeScope ).End)]"		
														blockoverride "icon_size" {
															size = { 20 20 }
														}
														blockoverride "glow_radius" {
															glow_radius = 3
														}
													}
												}
											}
											hbox = {
												tooltip = "[Character.GetProwessBreakdown]"
												using = tooltip_ne
												spacing = -3
												icon = {
													name = "prowess_icon"
													size = { 20 20 }
													texture = "gfx/interface/icons/icon_prowess.dds"
												}
												text_single = {
													name = "prowess_value"
													text = "[Character.GetProwess|0]"
													align = nobaseline
													default_format = "#high"
												}
											}
											expand = {}
										}
										expand = {}
									}
						
						
									button_artifact = {
										visible = "[GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(GetTitleByKey('d_kingsguard').GetHolder.MakeScope).End)]"
										scale = 0.75
										datacontext = "[Character.GetInventory.GetSlot('weapon').GetArtifact]"
										parentanchor = right
										position = { -60 0 }	
									}
									button_artifact = {
										visible = "[Not(GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(GetTitleByKey('d_kingsguard').GetHolder.MakeScope).End))]"
										scale = 0.75
										datacontext = "[Character.GetInventory.GetSlot('weapon').GetArtifact]"
										parentanchor = right	
									}

								}
					
								fixedgridbox = {
									name = "current_grid"
									addcolumn = 402
									addrow = 68
									datamodel_reuse_widgets = yes
									datamodel_wrap = 2
									flipdirection = yes
									datamodel = "[GetGlobalList('mde_current_kingsguard')]"

									item = {
										button_standard = {
											name = "background_button"
											size = { 402 68 }
											using = tooltip_ws
