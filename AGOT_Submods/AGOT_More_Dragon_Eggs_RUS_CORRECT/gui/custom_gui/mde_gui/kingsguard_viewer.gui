												datacontext = "[GetScriptedGui('mde_can_send_invite_for_kingsguard_sgui')]"
												visible = "[And(ScriptedGui.IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'owner', GetPlayer.MakeScope ).End), And(GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Scope.Char.MakeScope).End), Not(Character.GetInventory.GetSlot('weapon').IsEmpty)))]"
												enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'owner', GetPlayer.MakeScope ).End)]"
												tooltip = "INVITE_TO_KINGSGUARD_TT"
												using = tooltip_ne
									
												size = { 30 30 }
												parentanchor = right|vcenter
												position = { -127 0 }

												icon_round_button_base = {}

												button_icon = {
													onclick = "[Character.OpenPlayerInteraction( 'invite_to_kingsguard_interaction' )]"
													size = { 30 30 }
													parentanchor = center

													texture = "gfx/interface/icons/flat_icons/kingsguard_flat_black.dds"
										
													modify_texture = {
														texture = "gfx/interface/icons/focuses/hud_icon_mask.dds"
														blend_mode = alphamultiply
													}

													effectname = "NoHighlight"
												}
									
												expand = {}
											}
								
											portrait_head_small = {
												scale = 0.75
												parentanchor = right
												datacontext = "[Scope.Var('current_dragon').Char]"
												tooltipwidget = {
													cooltip_type = {
														blockoverride "interaction_info"
														{
															text = "CHARACTER_TOOLTIP_INSTRUCTION"
														}
													}
												}
												visible = "[GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Scope.Char.MakeScope).End)]"
											}
											button_artifact = {
												visible = "[And(Not(Character.GetInventory.GetSlot('weapon').IsEmpty), GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
												scale = 0.75
												datacontext = "[Character.GetInventory.GetSlot('weapon').GetArtifact]"
												parentanchor = right
												position = { -60 0 }	
											}
											button_artifact = {
												visible = "[And(Not(Character.GetInventory.GetSlot('weapon').IsEmpty), Not(GetScriptedGui('mde_rider_has_dragon').IsShown(GuiScope.SetRoot(Character.MakeScope).End)))]"
												scale = 0.75
												datacontext = "[Character.GetInventory.GetSlot('weapon').GetArtifact]"
												parentanchor = right	
											}
								
										}
									}
								}
				
							}
						}
						expand = {}
					}
				}
				button_event_standard = {
					block "button_size" {
						size = { 1220 36 }
					}
					highlight_icon = {
						size = { 1210 100% }
						gfxtype = togglepushbuttongfx
						effectname = "NoHighlight"
						texture = "gfx/interface/buttons/button_mouseover_event.dds"
						spriteType = Corneredstretched
						spriteborder = { 20 20 }
						framesize  = { 238 63 }
						parentanchor = center

						upframe = 1
						uphoverframe = 2
						uppressedframe = 1
						downframe = 1
						downhoverframe = 1
						downpressedframe = 1
						disableframe = 1

						alpha = 0.5

						block "button_standard_mouseover" {}
					}
					modify_texture = {
						name = "mask"
						texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
						spriteType = Corneredtiled
						spriteborder_left = 40
						spriteborder_right = 40
						blend_mode = alphamultiply
					}
					text_single = {
						alwaystransparent = yes
						parentanchor = center
						text = "MDE_gui_exit"
						default_format = "#high"
						align = center|nobaseline
						fontsize_min = 12
					}
					
					onclick = "[GetVariableSystem.Toggle( 'kingsguard_viewer_toggle' )]"
					
				}
			}
			
		}
	}
