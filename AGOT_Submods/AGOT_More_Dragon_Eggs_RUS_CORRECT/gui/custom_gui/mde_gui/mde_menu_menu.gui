window = {
	name = "menu_viewer_window"
	visible = "[And( And( Not( IsGameViewOpen('barbershop') ), IsDefaultGUIMode ), GetVariableSystem.Exists( 'menu_viewer_toggle' ) )]"
	parentanchor = center
	widgetanchor = center
	size = { 1420 585 }
	layer = middle
	alpha = 1

	using = Window_Background
    using = Window_Decoration_Spike

	state = {
        name = _show
        using = Animation_FadeIn_Standard
        using = Sound_WindowShow_Standard
		on_start = "[PdxGuiWidget.StackTop]"
    }


    state = {
        name = _hide
        using = Animation_FadeOut_Quick
        using = Sound_WindowHide_Standard
    }

	margin_widget = {
		name = "foreground_shader_vfx_container"
		position = { 40 20 }
		size = { 100% 100% }
		margin = { 40 20 }
	}
	margin_widget = {
		name = "faux_event_background"
		size = { 100% 100% }
		margin = { 40 20 }

		state = {
			name = _show
			using = Animation_FadeIn_Standard
			duration = 0.7
		}

		state = {
			name = background_shake_loop
			next = background_shake_loop_1
			duration = 0.0
			alpha = 1.0
		}

		state = {
			name = background_shake_loop_1
			next = background_shake_loop_2
			position = { -6 0 }
			duration = 0.2
		}

		state = {
			name = background_shake_loop_2
			next = background_shake_loop_3
			position = { 5 0 }
			duration = 0.12
		}

		state = {
			name = background_shake_loop_3
			next = background_shake_loop_1
			position = { 7 1 }
			duration = 0.12
		}

		blockoverride "event_picture_properties"
		{}
		widget = {
			name = "event_picture"
			size = { 100% 100% }

			background = {
				texture = "gfx/interface/illustrations/event_scenes/agot_dragonpit.dds"
				fittype = centercrop

				block "event_mask" {
					modify_texture = {
						name = mask
						texture = "gfx/interface/window_event/mask_event_image_large.dds"
						blend_mode = alphamultiply

						block "event_mask_properties"
						{
							loop = no
						}
					}
				}

				block "event_picture_properties"
				{
				}
			}
		}
	}
	
	
	
	vbox = {
		name = "not_event_window"
		using = Animation_Tab_Switch
		layoutpolicy_vertical = expanding
		spacer = { size = { 0 50 } }
		expand = {}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 2

			state = {
				name = _show
				trigger_when = "[Not( Or(Or(GetVariableSystem.HasValue('menu_viewer_mode', 'viewer_mode_gamerule'), GetVariableSystem.HasValue('menu_viewer_mode', 'viewer_mode_buttons')), And(GetVariableSystem.HasValue('menu_viewer_mode', 'viewer_mode_dragon_portrait'), GetScriptedGui('mde_player_has_living_dragon').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))) )]"
				on_start = "[GetVariableSystem.Set('menu_viewer_mode', 'viewer_mode_gamerule')]"
			}

			expand = {}
			button_round = {
				size = { 38 38 }
				name = "dragon_portrait_toggle"
				visible = "[GetScriptedGui('mde_player_has_living_dragon').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetVariableSystem.Set('menu_viewer_mode', 'viewer_mode_dragon_portrait')]"
				down = "[GetVariableSystem.HasValue('menu_viewer_mode', 'viewer_mode_dragon_portrait')]"
				tooltip = "dragon_portrait_toggle"
				button_icon_highlight = {
					texture = "gfx/interface/icons/flat_icons/capture_wild_dragon.dds"
					parentanchor = center
					alwaystransparent = yes
					size = { 34 34 }
				}
			}
			button_round = {
				size = { 38 38 }
				name = "gamerules_toggle"
				onclick = "[GetVariableSystem.Set('menu_viewer_mode', 'viewer_mode_gamerule')]"
				down = "[GetVariableSystem.HasValue('menu_viewer_mode', 'viewer_mode_gamerule')]"
				tooltip = "game_rule_toggle"
				button_icon_highlight = {
					texture = "gfx/interface/icons/flat_icons/rules.dds"
					parentanchor = center
					alwaystransparent = yes
					size = { 28 28 }
				}
			}
			button_round = {
				size = { 38 38 }
				name = "buttons_toggle"
				onclick = "[GetVariableSystem.Set('menu_viewer_mode', 'viewer_mode_buttons')]"
				down = "[GetVariableSystem.HasValue('menu_viewer_mode', 'viewer_mode_buttons')]"
				tooltip = "buttons_toggle"
				button_icon_highlight = {
					texture = "gfx/interface/icons/flat_icons/menu.dds"
					parentanchor = center
					alwaystransparent = yes
					size = { 20 20 }
				}
			}
			expand = {}
		}
		widget = {
			allow_outside = yes
			name = "widget_ingame_gamerule_manager"
			visible = "[GetVariableSystem.HasValue('menu_viewer_mode', 'viewer_mode_gamerule')]"
			using = tooltip_ws
			enabled = "[HostOnlyAccessIfMultiplayer]"
			tooltip_visible = "[Not( HostOnlyAccessIfMultiplayer )]"
			tooltipwidget = {
				container = {
					using = GeneralTooltipSetup
					alwaystransparent = no

					widget = {
						using = DefaultTooltipBackground
						size = { 100% 100% }
						alwaystransparent = no
					}

					textbox = {
						using = DefaultTooltipText
						margin = { 20 0 }
						margin_top = 12
						margin_bottom = 18
						text = "menu_menu_host_only"
					}
				}
			}
			size = { 1320 430 }
			vbox = {
				allow_outside = yes
				margin = { 0 -0 }

				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 460 37 }
