types MDE_Menu
{
	# For a pressed look, set down on the instance and override "down_visible" with the same condition.
	type mde_icon_banner_button = button_normal {
		size = { 90 90 }

		button = {
			size = { 88% 88% }
			parentanchor = center
			alwaystransparent = yes

			block "background_texture"
			{
				texture = "gfx/interface/window_situations/hud_situation_widget.dds"
			}
		}

		icon = {
			name = "down_gold"
			size = { 88% 88% }
			parentanchor = center
			alwaystransparent = yes
			texture = "gfx/interface/colors/white.dds"

			block "down_gold_color"
			{
				color = { 0.84 0.65 0.34 0.45 }
			}

			block "down_visible"
			{
				visible = no
			}

			modify_texture = {
				name = "banner_shape"
