window = {
	name = "egg_viewer_window"
	visible = "[And( And( Not( IsGameViewOpen('barbershop') ), IsDefaultGUIMode ), GetVariableSystem.Exists( 'egg_viewer_toggle' ) )]"
	parentanchor = center
	widgetanchor = center
	size = { 1320 585 }
	layer = middle
	alpha = 1

	using = Window_Background
    using = Window_Decoration_Spike

	state = {
        name = _show
        using = Animation_FadeIn_Standard
        using = Sound_WindowShow_Standard
		on_start = "[PdxGuiWidget.StackTop]"
    }


    state = {
        name = _hide
        using = Animation_FadeOut_Quick
        using = Sound_WindowHide_Standard
    }

	margin_widget = {
		name = "foreground_shader_vfx_container"
		position = { 40 20 }
		size = { 100% 100% }
		margin = { 40 20 }
	}
	margin_widget = {
		name = "faux_event_background"
		size = { 100% 100% }
		margin = { 40 20 }

		state = {
			name = _show
			using = Animation_FadeIn_Standard
			duration = 0.7
		}

		state = {
			name = background_shake_loop
			next = background_shake_loop_1
			duration = 0.0
			alpha = 1.0
		}

		state = {
			name = background_shake_loop_1
			next = background_shake_loop_2
			position = { -6 0 }
			duration = 0.2
		}

		state = {
			name = background_shake_loop_2
			next = background_shake_loop_3
			position = { 5 0 }
			duration = 0.12
		}

		state = {
			name = background_shake_loop_3
			next = background_shake_loop_1
			position = { 7 1 }
			duration = 0.12
		}

		blockoverride "event_picture_properties"
		{}
		widget = {
			name = "event_picture"
			size = { 100% 100% }

			background = {
				texture = "gfx/interface/illustrations/event_scenes/agot_dragonpit.dds"
				fittype = centercrop

				block "event_mask" {
					modify_texture = {
						name = mask
						texture = "gfx/interface/window_event/mask_event_image_large.dds"
						blend_mode = alphamultiply

						block "event_mask_properties"
						{
							loop = no
						}
					}
				}

				block "event_picture_properties"
				{
				}
			}
		}
	}
	
	
	vbox = {
		name = "not_event_window"
		using = Animation_Tab_Switch
		layoutpolicy_vertical = expanding
		spacer = { size = { 0 12 } }
		widget = {
			name = "egg_viewer_window_widget"
			size = { 1220 480 }
			vbox = {				
				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 460 307 }
					blockoverride "scrollbox_content"
					{
						flowcontainer = {
							name = "egg_grid"
							wrap_count = 3
							ignoreinvisible = yes
							datamodel = "[GetGlobalList('dragon_eggs')]"
							item = {
								button_standard = {
									size = { 500 90 } # Size of the button frame borders; needs to fit within the widget size
									max_width = 400
									datacontext = "[Scope.Artifact]"
									visible = "[Artifact.IsValid]"
									hbox = {
										widget = {
											size = { 90 90 }
											alwaystransparent = yes
											button_artifact = {
												size = { 100% 100% }
											}
										}

										vbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											margin_top = 4
											ignoreinvisible = yes
											spacing = -2
											hbox = {
												layoutpolicy_horizontal = expanding
												text_single = {
													layoutpolicy_horizontal = expanding
													text = "dragon_egg_alive_or_dead"
													using = Font_Size_Small
													default_format = "#high"
													fonttintcolor = { 0.721 0.321 0.894 0.8 }
													alpha = 1.2
												}
												expand = {}
											}

											hbox = {
												spacing = -5
												layoutpolicy_horizontal = expanding
												text_multi = {
													layoutpolicy_horizontal = expanding
													text = "[Artifact.GetNameNoTooltip]"
													max_width = 350
													using = Font_Size_Medium
													default_format = "#high"
													autoresize = yes
												}
												expand = {}
											}
											
											hbox = {
												layoutpolicy_horizontal = expanding
												
												text_single = {
													max_width = 200
													text = "[AGOTGetName(Artifact.GetOwner)|V]"
													visible = "[Not(GetScriptedGui('mde_is_dragonkeeper').IsShown( GuiScope.SetRoot( Artifact.GetOwner.MakeScope ).End ))]"
													using = Font_Size_Tiny
													fontsize_min = 5
													align = left|nobaseline
													autoresize = yes
												}
												text_single = {
													margin_top = 1
													fontsize_min = 9
													max_width = 230
													layoutpolicy_horizontal = expanding
													visible = "[GetScriptedGui('mde_is_dragonkeeper').IsShown( GuiScope.SetRoot( Artifact.GetOwner.MakeScope ).End )]"
													text = "mde_dragonkeeper_liege"
													using = Font_Size_Tiny
													align = left|nobaseline
													autoresize = yes
												}
												expand = {}
											}
											hbox = {
												margin_top = 2
												layoutpolicy_horizontal = expanding
												text_multi = {
													layoutpolicy_horizontal = expanding
													text = "mde_lineage_and_embryo"
													using = Font_Size_Tiny
													fontsize_min = 8
													align = left|nobaseline
													autoresize = yes
													max_width = 225
													max_height = 24
												}
												expand = {}
											}
											expand = {}
										}
									}
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										expand = {}

										portrait_head_small = {
											datacontext = "[Artifact.GetOwner]"
										}
									}
								}
							}
						}
						
					}
				}
				button_event_standard = {
					block "button_size" {
						size = { 1220 36 }
					}
					highlight_icon = {
						size = { 1210 100% }
						gfxtype = togglepushbuttongfx
						effectname = "NoHighlight"
						texture = "gfx/interface/buttons/button_mouseover_event.dds"
						spriteType = Corneredstretched
						spriteborder = { 20 20 }
						framesize  = { 238 63 }
						parentanchor = center

						upframe = 1
						uphoverframe = 2
						uppressedframe = 1
						downframe = 1
						downhoverframe = 1
						downpressedframe = 1
						disableframe = 1

						alpha = 0.5

						block "button_standard_mouseover" {}
					}
					modify_texture = {
						name = "mask"
						texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
						spriteType = Corneredtiled
						spriteborder_left = 40
						spriteborder_right = 40
						blend_mode = alphamultiply
					}
					text_single = {
						alwaystransparent = yes
						parentanchor = center
						text = "MDE_gui_exit"
						default_format = "#high"
						align = center|nobaseline
						fontsize_min = 12
					}
					
					onclick = "[GetVariableSystem.Toggle( 'egg_viewer_toggle' )]"
					
				}
			}
			
		}
	}
	widget = {
		size = { 2390 76 }

		widget = {
			size = { 100% 57 }
			position = { 0 20 }

			icon = {
				name = "theme_header"
				position = { 24 0 }
				size = { 1072 57 }
				texture = "gfx/interface/window_event/event_header_red.dds"

				modify_texture = {
					name = overlay
					texture = "gfx/interface/component_effects/effect_header_blue_shine.dds"
					blend_mode = colordodge
					translate_uv = { 0.6 0 }
				}

				state = {
					name = right
					next = left

					duration = 8
					bezier = { 0.8 0.18 0.96 .05 }

					modify_texture = {
						name = overlay
						translate_uv = { -0.6 0 }
					}
				}

				state = {
					name = left
					next = right

					duration = 0.0
					delay = 5

					modify_texture = {
						name = overlay
						translate_uv = { 0.6 0 }
					}
				}

				state = {
					trigger_on_create = yes
					name = start
					next = right

					duration = 0.0

					modify_texture = {
						name = overlay
						translate_uv = { 0.6 0 }
					}
				}
			}

			text_single = {
				name = "title"
				position = { 128 1 }
				fontsize = 29
				fontsize_min = 16
				text = "egg_viewer.t"
				default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
				using = Font_Type_Flavor
				max_width = 950

				alpha = 0

				state = {
					name = start
					trigger_on_create = yes
					delay = 0.2
					using = Animation_Curve_Default
					alpha = 1
					duration = 0.5
				}
			}

			icon = {
				name = "theme_icon"
				position = { 28 -19 }
				size = { 80 80 }
				texture = "gfx/interface/icons/event_types/type_dragon.dds"

				modify_texture = {
					name = overlay
					texture = "gfx/interface/component_effects/effect_blue_shine.dds"
					blend_mode = colordodge
					translate_uv = { 0.6 0 }
				}

				state = {
					name = right
					next = left

					duration = 2
					bezier = { .8 .18 .96 .05 }

					modify_texture = {
						name = overlay
						translate_uv = { -0.6 0 }
					}
				}

				state = {
					name = left
					next = right

					duration = 0.0
					delay = 5


					modify_texture = {
						name = overlay
						translate_uv = { 0.6 0 }
					}
				}

				state = {
					trigger_on_create = yes
					name = start
					next = right

					duration = 0.0

					modify_texture = {
						name = overlay
						translate_uv = {0.6 0}
					}
				}
				
			}
			
		}
	}
}
